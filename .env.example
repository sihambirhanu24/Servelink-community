# Database
# For remote/serverless Postgres (e.g. Neon) add connect_timeout (seconds); Prisma's default of 5s
# is too short when the database handshake regularly takes 4-6s: ...?sslmode=require&connect_timeout=20
DATABASE_URL="postgresql://user:password@localhost:5432/servelink"

# JWT
JWT_SECRET="your-secret-key"
JWT_EXPIRES_IN="7d"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# LiveKit Configuration (backend only — never expose LIVEKIT_API_SECRET to the browser)
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"
LIVEKIT_URL="wss://your-livekit-url.livekit.cloud"
# Optional frontend fallback. The join API already returns serverUrl, so this is not required.
# NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-url.livekit.cloud"

# Chapa Payment Gateway
CHAPA_SECRET_KEY="CHASECK_TEST-xxxxxxxxxxxx"
CHAPA_PUBLIC_KEY="CHASECK_TEST-xxxxxxxxxxxx"
CHAPA_TEST_MODE="true" 
# If running LiveKit locally, use:
# LIVEKIT_API_KEY="devkey"
# LIVEKIT_API_SECRET="secret"
# LIVEKIT_URL="ws://localhost:7880"
