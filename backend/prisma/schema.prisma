generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id                                String                         @id @default(cuid())
  firstName                         String
  lastName                          String
  email                             String                         @unique
  password                          String
  profileImage                      String?
  subject                           String?
  verified                          Boolean                        @default(false)
  level                             TeacherLevelType               @default(LEVEL_1)
  school                            String
  woreda                            String
  zone                              String
  region                            String
  createdAt                         DateTime                       @default(now())
  updatedAt                         DateTime                       @updatedAt
  status                            TeacherStatus                  @default(ACTIVE)
  /// Professional department (e.g. "Mathematics", "English", "Physics").
  /// Required for LEVEL_2–5 teachers; optional/unused for LEVEL_1.
  department                        String?
  /// Total progression points earned by the teacher
  points                            Int                            @default(0)
  /// Expiration time of the current 24-hour privilege (null if no active privilege)
  privilegeExpiresAt                DateTime?
  /// Start time of the current 24-hour privilege (null if no active privilege)
  privilegeStartAt                  DateTime?
  /// When the teacher was approved by admin
  approvedAt                        DateTime?
  /// Admin ID who approved this teacher
  approvedBy                        String?
  /// Reason provided by admin if verification was rejected
  rejectionReason                   String?
  /// Teacher verification status for admin approval
  verificationStatus                TeacherVerificationStatus      @default(PENDING)
  bio                               String?
  city                              String?
  dateOfBirth                       DateTime?
  /// Personal information for verification
  gender                            String?
  gradeLevel                        String?
  phone                             String?
  /// Professional information for verification
  profession                        String?
  schoolLocation                    String?
  /// School information for verification
  schoolType                        String?
  skills                            String?
  specialization                    String?
  yearsOfExperience                 Int?
  bannerUrl                         String?
  teacherIdNumber                   String?
  suspendedBy                       String?
  suspensionCount                   Int                            @default(0)
  /// Suspension fields
  suspensionReason                  String?
  suspensionStart                   DateTime?
  suspensionUntil                   DateTime?
  announcementReads                 AnnouncementRead[]
  chatMessages                      ChatMessage[]
  chatMessageReads                  ChatMessageRead[]
  chatReactions                     ChatReaction[]
  directConversationsAsParticipant1 ChatRoom[]                     @relation("DirectConversationParticipant1")
  directConversationsAsParticipant2 ChatRoom[]                     @relation("DirectConversationParticipant2")
  chatUnreadCounts                  ChatUnreadCount[]
  commentReactions                  CommentReaction[]
  communityBookmarks                CommunityBookmark[]
  comments                          CommunityComment[]
  communityLikes                    CommunityLike[]
  communityMembers                  CommunityMember[]
  posts                             CommunityPost[]
  communityReports                  CommunityReport[]
  discussions                       Discussion[]
  discussionBookmarks               DiscussionBookmark[]
  discussionReadStates              DiscussionReadState[]
  discussionReports                 DiscussionReport[]
  liveSessions                      LiveSession[]
  liveSessionRegistrations          LiveSessionRegistration[]
  notifications                     Notification[]
  notificationPreference            NotificationPreference?
  payments                          Payment[]
  payouts                           Payout[]
  pinnedMessages                    PinnedMessage[]
  appeals                           SuspensionAppeal[]
  suspensionHistory                 SuspensionHistory[]
  activities                        TeacherActivity[]
  teacherEarnings                   TeacherEarning[]
  followers                         TeacherFollow[]                @relation("TeacherFollows")
  following                         TeacherFollow[]                @relation("TeacherFollowing")
  locationChangeRequests            TeacherLocationChangeRequest[]
  locationHistory                   TeacherLocationHistory[]
  payoutProfile                     TeacherPayoutProfile?
  verificationDocuments             TeacherVerificationDocument[]
  supportProviderProfile            SupportProviderProfile?
  requestedSupport                  SupportRequest[]               @relation("SupportRequester")
  walletBalance                     WalletBalance?
  walletTransactions                WalletTransaction[]
  relatedWalletTransactions         WalletTransaction[]            @relation("RelatedTeacher")
  financialSupportRequests          FinancialSupportRequest[]
  contributionsMade                 FinancialContribution[]        @relation("FinancialContributor")
  contributionsReceived             FinancialContribution[]        @relation("FinancialRecipient")

  @@index([status])
  @@index([status, suspensionUntil])
}

model TeacherPayoutProfile {
  id          String   @id @default(cuid())
  teacherId   String   @unique
  phoneNumber String   @unique
  provider    String   @default("TELEBIRR")
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    Teacher  @relation("TeacherFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   Teacher  @relation("TeacherFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Admin {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  liveSessions LiveSession[]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Community {
  id               String            @id @default(cuid())
  name             String
  type             CommunityType
  school           String?
  woreda           String?
  zone             String?
  region           String?
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// COMMON = all teachers at this level/scope regardless of department.
  /// DEPARTMENT = restricted to a single department within this level/scope.
  /// SCHOOL communities are always COMMON (LEVEL_1 has no department split).
  subtype          CommunitySubtype  @default(COMMON)
  /// Department name — only set when subtype = DEPARTMENT.
  department       String?
  isActive         Boolean           @default(true)
  announcements    Announcement[]
  chatRoom         ChatRoom?
  communityMembers CommunityMember[]
  posts            CommunityPost[]

  @@unique([type, subtype, school, woreda, zone, region, department], name: "unique_community_scope")
}

model CommunityMember {
  id          String           @id @default(cuid())
  teacherId   String
  communityId String
  createdAt   DateTime         @default(now())
  status      MembershipStatus @default(PENDING)
  community   Community        @relation(fields: [communityId], references: [id])
  teacher     Teacher          @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, communityId])
}

model Category {
  id          String          @id @default(cuid())
  name        String          @unique
  createdAt   DateTime        @default(now())
  posts       CommunityPost[]
  discussions Discussion[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]
}

model CommunityPost {
  id                 String               @id @default(cuid())
  title              String
  description        String
  teacherId          String
  communityId        String
  categoryId         String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  views              Int                  @default(0)
  isResolved         Boolean              @default(false)
  postType           PostType             @default(DISCUSSION)
  /// Q&A: id of the accepted CommunityComment (best answer)
  bestAnswerId       String?
  /// Q&A: deadline (server-authoritative; null for non-questions)
  deadline           DateTime?
  /// Q&A: OPEN → CLOSED (deadline passed) → SOLVED (best answer picked)
  questionStatus     QuestionStatus       @default(OPEN)
  /// Q&A: when question became SOLVED
  solvedAt           DateTime?
  /// When moderation action was taken
  moderatedAt        DateTime?
  /// Admin ID who moderated this post
  moderatedById      String?
  /// Reason for moderation action
  moderationReason   String?
  /// Moderation status for admin content management
  moderationStatus   PostModerationStatus @default(ACTIVE)
  attachments        Attachment[]
  communityBookmarks CommunityBookmark[]
  comments           CommunityComment[]
  communityLikes     CommunityLike[]
  category           Category             @relation(fields: [categoryId], references: [id])
  community          Community            @relation(fields: [communityId], references: [id])
  teacher            Teacher              @relation(fields: [teacherId], references: [id])
  communityReports   CommunityReport[]
  moderationHistory  ModerationHistory[]
  tags               PostTag[]

  @@index([postType])
  @@index([questionStatus])
  @@index([deadline])
  @@index([teacherId])
  @@index([communityId])
  @@index([moderationStatus])
}

model Attachment {
  id        String         @id @default(cuid())
  url       String
  fileName  String
  fileSize  Int
  type      AttachmentType
  postId    String
  createdAt DateTime       @default(now())
  post      CommunityPost  @relation(fields: [postId], references: [id])
}

model CommunityComment {
  id         String            @id @default(cuid())
  content    String
  teacherId  String
  postId     String
  parentId   String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  isAccepted Boolean           @default(false)
  reactions  CommentReaction[]
  post       CommunityPost     @relation(fields: [postId], references: [id])
  teacher    Teacher           @relation(fields: [teacherId], references: [id])
}

model CommentReaction {
  id        String           @id @default(cuid())
  commentId String
  teacherId String
  reaction  String           @default("HELPFUL")
  createdAt DateTime         @default(now())
  comment   CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  teacher   Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([commentId, teacherId])
  @@index([commentId])
  @@index([teacherId])
}

model CommunityLike {
  id        String        @id @default(cuid())
  teacherId String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
}

model CommunityBookmark {
  id        String        @id @default(cuid())
  teacherId String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
}

model CommunityReport {
  id           String        @id @default(cuid())
  reason       ReportReason
  description  String?
  teacherId    String
  postId       String
  createdAt    DateTime      @default(now())
  status       ReportStatus  @default(PENDING)
  updatedAt    DateTime      @updatedAt
  /// When the report was reviewed
  reviewedAt   DateTime?
  /// Admin ID who reviewed this report (internal only — never exposed to post owner)
  reviewedById String?
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  teacher      Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
  @@index([status])
  @@index([teacherId])
  @@index([postId])
}

model ModerationHistory {
  id        String           @id @default(cuid())
  postId    String
  teacherId String
  adminId   String
  action    ModerationAction
  reason    String?
  createdAt DateTime         @default(now())
  post      CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([teacherId])
  @@index([adminId])
  @@index([createdAt])
}

model PostTag {
  postId String
  tagId  String
  post   CommunityPost @relation(fields: [postId], references: [id])
  tag    Tag           @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

model TeacherActivity {
  id          String              @id @default(cuid())
  teacherId   String
  type        TeacherActivityType
  points      Int
  referenceId String?
  createdAt   DateTime            @default(now())
  teacher     Teacher             @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, type, referenceId])
  @@index([teacherId])
  @@index([teacherId, type, createdAt])
}

model TeacherVerificationDocument {
  id         String                   @id @default(cuid())
  teacherId  String
  fileName   String
  filePath   String
  fileType   VerificationDocumentType
  mimeType   String
  fileSize   Int
  uploadedAt DateTime                 @default(now())
  teacher    Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model Notification {
  id          String           @id @default(cuid())
  title       String
  message     String
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  receiverId  String
  referenceId String?
  type        NotificationType
  updatedAt   DateTime         @updatedAt
  senderId    String?
  senderName  String?
  receiver    Teacher          @relation(fields: [receiverId], references: [id], onDelete: Cascade)
}

model ChatRoom {
  id               String            @id @default(cuid())
  communityId      String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// Optional link to a CommunityPost (DISCUSSION) — each discussion gets its own chat room
  discussionPostId String?           @unique
  /// Direct message conversation between two teachers
  isDirect         Boolean           @default(false)
  /// First participant in direct message (sorted by ID to ensure uniqueness)
  participant1Id   String?
  /// Second participant in direct message
  participant2Id   String?
  messages         ChatMessage[]
  community        Community?        @relation(fields: [communityId], references: [id], onDelete: Cascade)
  participant1     Teacher?          @relation("DirectConversationParticipant1", fields: [participant1Id], references: [id], onDelete: Cascade)
  participant2     Teacher?          @relation("DirectConversationParticipant2", fields: [participant2Id], references: [id], onDelete: Cascade)
  unreadCounts     ChatUnreadCount[]
  pinnedMessages   PinnedMessage[]

  @@unique([participant1Id, participant2Id])
  @@index([communityId])
  @@index([discussionPostId])
  @@index([participant1Id])
  @@index([participant2Id])
}

model ChatMessage {
  id            String            @id @default(cuid())
  chatRoomId    String
  senderId      String
  content       String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  replyToId     String?
  editedAt      DateTime?
  deletedAt     DateTime?
  attachments   ChatAttachment[]
  chatRoom      ChatRoom          @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  replyTo       ChatMessage?      @relation("MessageReplies", fields: [replyToId], references: [id])
  replies       ChatMessage[]     @relation("MessageReplies")
  sender        Teacher           @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readBy        ChatMessageRead[]
  reactions     ChatReaction[]
  pinnedMessage PinnedMessage?

  @@index([chatRoomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([deletedAt])
}

model ChatAttachment {
  id        String         @id @default(cuid())
  messageId String
  url       String
  fileName  String
  fileSize  Int
  type      AttachmentType
  createdAt DateTime       @default(now())
  message   ChatMessage    @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model ChatReaction {
  id        String      @id @default(cuid())
  messageId String
  teacherId String
  reaction  String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([messageId, teacherId, reaction])
  @@index([messageId])
  @@index([teacherId])
}

model ChatMessageRead {
  id        String      @id @default(cuid())
  messageId String
  teacherId String
  readAt    DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  teacher   Teacher     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([messageId, teacherId])
  @@index([messageId])
  @@index([teacherId])
}

model PinnedMessage {
  id              String      @id @default(cuid())
  chatRoomId      String
  messageId       String      @unique
  pinnedBy        String
  createdAt       DateTime    @default(now())
  chatRoom        ChatRoom    @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  message         ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedByTeacher Teacher     @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)

  @@index([chatRoomId])
  @@index([messageId])
}

model ChatUnreadCount {
  id         String   @id @default(cuid())
  chatRoomId String
  teacherId  String
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  teacher    Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, teacherId])
  @@index([chatRoomId])
  @@index([teacherId])
}

model TeacherLocationChangeRequest {
  id               String               @id @default(cuid())
  teacherId        String
  currentSchool    String?
  requestedSchool  String?
  currentWoreda    String?
  requestedWoreda  String?
  currentZone      String?
  requestedZone    String?
  currentRegion    String?
  requestedRegion  String?
  currentSubject   String?
  requestedSubject String?
  reason           String
  status           LocationChangeStatus @default(PENDING)
  fileName         String?
  filePath         String?
  mimeType         String?
  fileSize         Int?
  adminId          String?
  adminComment     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  reviewedAt       DateTime?
  teacher          Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
}

model TeacherLocationHistory {
  id              String   @id @default(cuid())
  teacherId       String
  school          String?
  woreda          String?
  zone            String?
  region          String?
  subject         String?
  startedAt       DateTime
  endedAt         DateTime @default(now())
  changeRequestId String?
  teacher         Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

model Announcement {
  id             String             @id @default(cuid())
  title          String
  content        String
  type           AnnouncementType   @default(GENERAL)
  status         AnnouncementStatus @default(DRAFT)
  targetAudience AnnouncementTarget @default(ALL_TEACHERS)
  communityId    String?
  /// Admin ID who created this announcement
  createdById    String
  /// Snapshot of the admin's name at creation time
  createdByName  String
  attachmentUrl  String?
  attachmentName String?
  attachmentSize Int?
  publishedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  community      Community?         @relation(fields: [communityId], references: [id])
  reads          AnnouncementRead[]

  @@index([status])
  @@index([createdById])
  @@index([targetAudience])
  @@index([publishedAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  teacherId      String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  teacher        Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([announcementId, teacherId])
  @@index([announcementId])
  @@index([teacherId])
}

model CommunityGuideline {
  id          String   @id @default(cuid())
  title       String
  description String
  icon        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model Discussion {
  id           String                @id @default(cuid())
  title        String
  description  String
  authorId     String
  categoryId   String?
  /// Tags for discovery (e.g., #ClassroomManagement, #TeachingStrategies)
  tags         String[]              @default([])
  views        Int                   @default(0)
  replyCount   Int                   @default(0)
  isActive     Boolean               @default(true)
  isPinned     Boolean               @default(false)
  lastActiveAt DateTime              @default(now())
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  author       Teacher               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category     Category?             @relation(fields: [categoryId], references: [id])
  bookmarks    DiscussionBookmark[]
  readStates   DiscussionReadState[]
  reports      DiscussionReport[]

  @@index([authorId])
  @@index([categoryId])
  @@index([isActive])
  @@index([isPinned])
  @@index([lastActiveAt])
  @@index([createdAt])
}

model DiscussionBookmark {
  id           String     @id @default(cuid())
  discussionId String
  teacherId    String
  createdAt    DateTime   @default(now())
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([discussionId, teacherId])
  @@index([discussionId])
  @@index([teacherId])
}

model DiscussionReport {
  id           String       @id @default(cuid())
  discussionId String
  teacherId    String
  reason       ReportReason
  description  String?
  status       ReportStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  discussion   Discussion   @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([discussionId, teacherId])
  @@index([discussionId])
  @@index([teacherId])
  @@index([status])
}

model DiscussionReadState {
  id           String     @id @default(cuid())
  discussionId String
  teacherId    String
  lastReadAt   DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  teacher      Teacher    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([discussionId, teacherId])
  @@index([discussionId])
  @@index([teacherId])
}

model SuspensionHistory {
  id             String         @id @default(cuid())
  teacherId      String
  suspensionType SuspensionType
  reason         String
  suspendedBy    String
  suspendedAt    DateTime       @default(now())
  suspendedUntil DateTime?
  restoredAt     DateTime?
  restoredBy     String?
  reportId       String?
  createdAt      DateTime       @default(now())
  teacher        Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([suspendedAt])
  @@index([teacherId, restoredAt])
}

model SuspensionAppeal {
  id            String       @id @default(cuid())
  teacherId     String
  subject       String
  explanation   String
  attachmentUrl String?
  status        AppealStatus @default(PENDING)
  reviewedBy    String?
  reviewedAt    DateTime?
  adminResponse String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teacher       Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  teacherId            String   @unique
  soundEnabled         Boolean  @default(true)
  soundType            String   @default("ServeLink")
  browserNotifications Boolean  @default(false)
  messages             Boolean  @default(true)
  communityActivity    Boolean  @default(true)
  questions            Boolean  @default(true)
  discussions          Boolean  @default(true)
  resources            Boolean  @default(true)
  levelProgress        Boolean  @default(true)
  announcements        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  teacher              Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model LiveSession {
  id                 String                    @id @default(cuid())
  teacherId          String
  adminId            String?
  topic              String
  description        String?
  scheduledStart     DateTime
  duration           Int
  status             LiveSessionStatus         @default(REQUESTED)
  rejectionReason    String?
  meetingRoomId      String?                   @unique
  startedAt          DateTime?
  endedAt            DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  isPaid             Boolean                   @default(false)
  price              Decimal?                  @db.Decimal(10, 2)
  maxParticipants    Int?
  visibility         LiveSessionVisibility     @default(NETWORK)
  cancelledAt        DateTime?
  cancelledById      String?
  archivedAt         DateTime?
  livekitRoomName    String?                   @unique
  provider           LiveSessionProvider       @default(LIVEKIT)
  meetingUrl         String?
  financialAuditLogs FinancialAuditLog[]
  admin              Admin?                    @relation(fields: [adminId], references: [id])
  teacher            Teacher                   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  registrations      LiveSessionRegistration[]
  payments           Payment[]

  @@index([teacherId])
  @@index([adminId])
  @@index([status])
  @@index([scheduledStart])
}

model LiveSessionRegistration {
  id            String             @id @default(cuid())
  teacherId     String
  liveSessionId String
  paymentId     String?            @unique
  status        RegistrationStatus @default(REGISTERED)
  registeredAt  DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  liveSession   LiveSession        @relation(fields: [liveSessionId], references: [id], onDelete: Cascade)
  payment       Payment?           @relation(fields: [paymentId], references: [id])
  teacher       Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, liveSessionId])
  @@index([liveSessionId])
  @@index([teacherId])
  @@index([paymentId])
}

model Payment {
  id                      String                   @id @default(cuid())
  teacherId               String
  liveSessionId           String?
  amount                  Decimal                  @db.Decimal(10, 2)
  currency                String                   @default("ETB")
  status                  PaymentStatus            @default(PENDING)
  paymentMethod           PaymentMethod
  transactionRef          String                   @unique
  chapaTxRef              String?                  @unique
  chapaCheckoutUrl        String?
  metadata                Json?
  failureReason           String?
  verifiedAt              DateTime?
  completedAt             DateTime?
  refundedAt              DateTime?
  refundAmount            Decimal?                 @db.Decimal(10, 2)
  refundReason            String?
  idempotencyKey          String                   @unique
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  chapaReference          String?                  @unique
  refundStatus            RefundStatus             @default(NOT_REQUIRED)
  chapaRefundRefId        String?
  refundIdempotencyKey    String?                  @unique
  refundFailureReason     String?
  refundInitiatedAt       DateTime?
  refundLastCheckedAt     DateTime?
  financialAuditLogs      FinancialAuditLog[]
  liveSessionRegistration LiveSessionRegistration?
  liveSession             LiveSession?             @relation(fields: [liveSessionId], references: [id])
  teacher                 Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherEarnings         TeacherEarning[]

  @@index([refundStatus])
  @@index([teacherId])
  @@index([liveSessionId])
  @@index([status])
  @@index([transactionRef])
  @@index([createdAt])
}

model TeacherEarning {
  id                   String        @id @default(cuid())
  teacherId            String
  liveSessionId        String?
  paymentId            String?
  grossAmount          Decimal       @db.Decimal(10, 2)
  platformFee          Decimal       @db.Decimal(10, 2)
  netAmount            Decimal       @db.Decimal(10, 2)
  status               EarningStatus @default(PENDING)
  payoutId             String?
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  refundReviewRequired Boolean       @default(false)
  payment              Payment?      @relation(fields: [paymentId], references: [id])
  payout               Payout?       @relation(fields: [payoutId], references: [id])
  teacher              Teacher       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([liveSessionId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model Payout {
  id                String           @id @default(cuid())
  teacherId         String
  amount            Decimal          @db.Decimal(10, 2)
  feeAmount         Decimal?         @db.Decimal(10, 2)
  netAmount         Decimal?         @db.Decimal(10, 2)
  currency          String           @default("ETB")
  status            PayoutStatus     @default(PENDING)
  bankCode          String?
  bankName          String?
  bankAccountNumber String?
  bankAccountName   String?
  reference         String           @unique
  rejectionReason   String?
  approvedBy        String?
  approvedAt        DateTime?
  processedBy       String?
  processedAt       DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  metadata          Json?
  chapaTransferId   String?          @unique
  chapaReference    String?          @unique
  bankReference     String?
  chapaStatus       String?
  webhookReceivedAt DateTime?
  submittedAt       DateTime?
  lastVerifiedAt    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  teacher           Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherEarnings   TeacherEarning[]

  @@index([teacherId])
  @@index([status])
  @@index([createdAt])
  @@index([chapaTransferId])
  @@index([chapaReference])
  @@index([reference])
}

model PlatformSettings {
  id                 String   @id @default(cuid())
  platformFeePercent Decimal  @default(15.00) @db.Decimal(5, 2)
  minPayoutAmount    Decimal  @default(100.00) @db.Decimal(10, 2)
  chapaPublicKey     String?
  chapaSecretKey     String?
  chapaTestMode      Boolean  @default(true)
  updatedAt          DateTime @updatedAt
  autoApprovePayouts Boolean  @default(false)
}

model FinancialAuditLog {
  id            String       @id @default(cuid())
  actorId       String
  actorIsAdmin  Boolean      @default(false)
  action        String
  liveSessionId String?
  paymentId     String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  liveSession   LiveSession? @relation(fields: [liveSessionId], references: [id])
  payment       Payment?     @relation(fields: [paymentId], references: [id])

  @@index([liveSessionId])
  @@index([paymentId])
  @@index([createdAt])
}

model SupportProviderProfile {
  id                String           @id @default(cuid())
  teacherId         String           @unique
  expertise         String[]
  experience        String
  description       String
  supportTypes      SupportType[]
  availabilityDays  String[]
  availabilityTime  String?
  maxActiveRequests Int              @default(5)
  isAvailable       Boolean          @default(true)
  completedSessions Int              @default(0)
  averageRating     Decimal?         @db.Decimal(3, 2)
  totalEarnings     Decimal          @default(0) @db.Decimal(10, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  teacher           Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  providedSupport   SupportRequest[] @relation("SupportProvider")
  receivedRatings   SupportRating[]

  @@index([teacherId])
  @@index([isAvailable])
}

model SupportRequest {
  id                 String                  @id @default(cuid())
  requesterId        String
  providerId         String?
  category           SupportCategory?
  topic              String
  description        String
  supportType        SupportType
  urgency            SupportUrgency
  preferredAt        DateTime?
  notes              String?
  status             SupportRequestStatus    @default(PENDING)
  chatRoomId         String?
  liveSessionId      String?
  paymentType        SupportPaymentType      @default(FREE)
  requestedAmount    Decimal?                @db.Decimal(10, 2)
  paymentReason      String?
  paymentStatus      SupportPaymentStatus    @default(NOT_REQUIRED)
  paymentReference   String?                 @unique
  reservedAt         DateTime?
  transferredAt      DateTime?
  releasedAt         DateTime?
  refundedAt         DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  acceptedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  requester          Teacher                 @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  provider           SupportProviderProfile? @relation("SupportProvider", fields: [providerId], references: [teacherId])
  rating             SupportRating?
  walletTransactions WalletTransaction[]

  @@index([requesterId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@index([supportType])
  @@index([paymentStatus])
  @@index([paymentReference])
}

model SupportRating {
  id               String                 @id @default(cuid())
  supportRequestId String                 @unique
  requesterId      String
  providerId       String
  rating           Int
  feedback         String?
  createdAt        DateTime               @default(now())
  supportRequest   SupportRequest         @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  provider         SupportProviderProfile @relation(fields: [providerId], references: [teacherId], onDelete: Cascade)

  @@index([supportRequestId])
  @@index([providerId])
  @@index([createdAt])
}

