generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id                 String              @id @default(cuid())
  firstName          String
  lastName           String
  email              String              @unique
  password           String
  profileImage       String?
  subject            String?
  verified           Boolean             @default(false)
  level              TeacherLevelType    @default(LEVEL_1)
  status             TeacherStatus       @default(ACTIVE)
  school             String
  woreda             String
  zone               String
  region             String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  communityBookmarks CommunityBookmark[]
  comments           CommunityComment[]
  communityLikes     CommunityLike[]
  communityMembers   CommunityMember[]
  posts              CommunityPost[]
  communityReports   CommunityReport[]
  notifications      Notification[]
  chatMessages       ChatMessage[]
  chatReactions      ChatReaction[]
  chatMessageReads   ChatMessageRead[]
  pinnedMessages     PinnedMessage[]
  chatUnreadCounts   ChatUnreadCount[]
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Community {
  id               String            @id @default(cuid())
  name             String
  type             CommunityType
  school           String?
  woreda           String?
  zone             String?
  region           String?
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  communityMembers CommunityMember[]
  posts            CommunityPost[]
  chatRoom         ChatRoom?
}

model CommunityMember {
  id String @id @default(cuid())

  teacherId   String
  communityId String

  status MembershipStatus @default(PENDING)

  createdAt DateTime @default(now())

  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([teacherId, communityId])
}

model Category {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  posts     CommunityPost[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]
}

model CommunityPost {
  id                 String              @id @default(cuid())
  title              String
  description        String
  teacherId          String
  communityId        String
  categoryId         String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attachments        Attachment[]
  communityBookmarks CommunityBookmark[]
  comments           CommunityComment[]
  communityLikes     CommunityLike[]
  category           Category            @relation(fields: [categoryId], references: [id])
  community          Community           @relation(fields: [communityId], references: [id])
  teacher            Teacher             @relation(fields: [teacherId], references: [id])
  communityReports   CommunityReport[]
  tags               PostTag[]
}

model Attachment {
  id        String         @id @default(cuid())
  url       String
  fileName  String
  fileSize  Int
  type      AttachmentType
  postId    String
  createdAt DateTime       @default(now())
  post      CommunityPost  @relation(fields: [postId], references: [id])
}

model CommunityComment {
  id        String        @id @default(cuid())
  content   String
  teacherId String
  postId    String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])
}

model CommunityLike {
  id        String        @id @default(cuid())
  teacherId String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
}

model CommunityBookmark {
  id        String        @id @default(cuid())
  teacherId String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
}

model CommunityReport {
  id          String        @id @default(cuid())
  reason      ReportReason
  description String?
  teacherId   String
  postId      String
  createdAt   DateTime      @default(now())
  post        CommunityPost @relation(fields: [postId], references: [id])
  teacher     Teacher       @relation(fields: [teacherId], references: [id])
}

model PostTag {
  postId String
  tagId  String
  post   CommunityPost @relation(fields: [postId], references: [id])
  tag    Tag           @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

enum TeacherLevelType {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
}

enum TeacherStatus {
  ACTIVE
  SUSPENDED
}

enum CommunityType {
  SCHOOL
  WOREDA
  ZONE
  REGION
  NATIONAL
}

enum ReportReason {
  SPAM
  ABUSE
  FAKE_INFORMATION
  OTHER
}

enum AttachmentType {
  IMAGE
  PDF
  DOCX
  VIDEO
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id          String           @id @default(cuid())
  receiverId  String
  receiver    Teacher          @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  senderId    String?
  senderName  String?
  title       String
  message     String
  type        NotificationType
  referenceId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum NotificationType {
  LIKE
  COMMENT
  BOOKMARK
  COMMUNITY_JOIN
  LEVEL_UPGRADE
  REPORT
  SYSTEM
  REPLY
  CHAT_MESSAGE
}

model ChatRoom {
  id                String          @id @default(cuid())
  communityId       String          @unique
  community         Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages          ChatMessage[]
  pinnedMessages    PinnedMessage[]
  unreadCounts      ChatUnreadCount[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([communityId])
}

model ChatMessage {
  id                String              @id @default(cuid())
  chatRoomId        String
  chatRoom          ChatRoom            @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId          String
  sender            Teacher             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content           String
  replyToId         String?
  replyTo           ChatMessage?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           ChatMessage[]       @relation("MessageReplies")
  editedAt          DateTime?
  deletedAt         DateTime?
  attachments       ChatAttachment[]
  reactions         ChatReaction[]
  readBy            ChatMessageRead[]
  pinnedMessage     PinnedMessage?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([chatRoomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([deletedAt])
}

model ChatAttachment {
  id          String    @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url         String
  fileName    String
  fileSize    Int
  type        AttachmentType
  createdAt   DateTime  @default(now())

  @@index([messageId])
}

model ChatReaction {
  id        String    @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reaction  String    // emoji like "👍", "❤️", "😂", etc.
  createdAt DateTime  @default(now())

  @@unique([messageId, teacherId, reaction])
  @@index([messageId])
  @@index([teacherId])
}

model ChatMessageRead {
  id        String    @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  readAt    DateTime  @default(now())

  @@unique([messageId, teacherId])
  @@index([messageId])
  @@index([teacherId])
}

model PinnedMessage {
  id        String    @id @default(cuid())
  chatRoomId String
  chatRoom  ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  messageId String    @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy  String
  pinnedByTeacher Teacher @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([chatRoomId])
  @@index([messageId])
}

model ChatUnreadCount {
  id        String    @id @default(cuid())
  chatRoomId String
  chatRoom  ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  count     Int       @default(0)
  updatedAt DateTime  @updatedAt

  @@unique([chatRoomId, teacherId])
  @@index([chatRoomId])
  @@index([teacherId])
}
