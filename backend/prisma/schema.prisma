model WalletBalance {
  id               String   @id @default(cuid())
  teacherId        String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(10, 2)
  reservedBalance  Decimal  @default(0) @db.Decimal(10, 2)
  totalBalance     Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  teacher          Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
}

enum WalletTransactionType {
  EARNING
  SUPPORT_RESERVE
  SUPPORT_TRANSFER_DEBIT
  SUPPORT_TRANSFER_CREDIT
  SUPPORT_RELEASE
  SUPPORT_REFUND_DEBIT
  SUPPORT_REFUND_CREDIT
  FINANCIAL_SUPPORT_CONTRIBUTION
  FINANCIAL_SUPPORT_RECEIVED
  PAYOUT_DEBIT
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

model WalletTransaction {
  id                String                   @id @default(cuid())
  teacherId         String
  type              WalletTransactionType
  amount            Decimal                  @db.Decimal(10, 2)
  balanceBefore     Decimal                  @db.Decimal(10, 2)
  balanceAfter      Decimal                  @db.Decimal(10, 2)
  status            WalletTransactionStatus  @default(COMPLETED)
  reference         String                   @unique
  supportRequestId  String?
  relatedTeacherId  String?
  metadata          Json?
  description       String
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  teacher           Teacher                  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  supportRequest    SupportRequest?          @relation(fields: [supportRequestId], references: [id])
  relatedTeacher    Teacher?                 @relation("RelatedTeacher", fields: [relatedTeacherId], references: [id])

  @@index([teacherId])
  @@index([supportRequestId])
  @@index([reference])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────
// FINANCIAL SUPPORT SYSTEM (Teacher-to-Teacher Assistance)
// ─────────────────────────────────────────────────────────────────────────

enum FinancialSupportStatus {
  OPEN
  PARTIALLY_FUNDED
  GOAL_REACHED
  CANCELLED
  CLOSED
  EXPIRED
}

model FinancialSupportRequest {
  id              String                   @id @default(cuid())
  requesterId     String
  amountNeeded    Decimal                  @db.Decimal(10, 2)
  amountReceived  Decimal                  @default(0) @db.Decimal(10, 2)
  reason          String
  additionalNotes String?
  status          FinancialSupportStatus   @default(OPEN)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  completedAt     DateTime?
  expiresAt       DateTime?
  cancelledAt     DateTime?
  requester       Teacher                  @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  contributions   FinancialContribution[]

  @@index([requesterId])
  @@index([status])
  @@index([createdAt])
}

model FinancialContribution {
  id                       String                   @id @default(cuid())
  supportRequestId         String
  contributorId            String
  recipientId              String
  amount                   Decimal                  @db.Decimal(10, 2)
  transactionReference     String                   @unique
  createdAt                DateTime                 @default(now())
  supportRequest           FinancialSupportRequest  @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)
  contributor              Teacher                  @relation("FinancialContributor", fields: [contributorId], references: [id], onDelete: Cascade)
  recipient                Teacher                  @relation("FinancialRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([supportRequestId])
  @@index([contributorId])
  @@index([recipientId])
  @@index([transactionReference])
  @@index([createdAt])
}
