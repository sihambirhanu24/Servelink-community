generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id                    String                        @id @default(cuid())
  firstName             String
  lastName              String
  email                 String                        @unique
  password              String
  profileImage          String?
  subject               String?
  verified              Boolean                       @default(false)
  level                 TeacherLevelType              @default(LEVEL_1)
  status                TeacherStatus                 @default(ACTIVE)
  school                String
  woreda                String
  zone                  String
  region                String
  /// Professional department (e.g. "Mathematics", "English", "Physics").
  /// Required for LEVEL_2–5 teachers; optional/unused for LEVEL_1.
  department            String?
  /// Total progression points earned by the teacher
  points                Int                           @default(0)
  /// Start time of the current 24-hour privilege (null if no active privilege)
  privilegeStartAt      DateTime?
  /// Expiration time of the current 24-hour privilege (null if no active privilege)
  privilegeExpiresAt    DateTime?
  /// Teacher verification status for admin approval
  verificationStatus    TeacherVerificationStatus     @default(PENDING)
  /// Reason provided by admin if verification was rejected
  rejectionReason       String?
  /// When the teacher was approved by admin
  approvedAt            DateTime?
  /// Admin ID who approved this teacher
  approvedBy            String?
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  communityBookmarks    CommunityBookmark[]
  comments              CommunityComment[]
  communityLikes        CommunityLike[]
  communityMembers      CommunityMember[]
  posts                 CommunityPost[]
  communityReports      CommunityReport[]
  notifications         Notification[]
  chatMessages          ChatMessage[]
  chatReactions         ChatReaction[]
  chatMessageReads      ChatMessageRead[]
  pinnedMessages        PinnedMessage[]
  chatUnreadCounts      ChatUnreadCount[]
  activities            TeacherActivity[]
  verificationDocuments TeacherVerificationDocument[]
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Community {
  id               String            @id @default(cuid())
  name             String
  type             CommunityType
  /// COMMON = all teachers at this level/scope regardless of department.
  /// DEPARTMENT = restricted to a single department within this level/scope.
  /// SCHOOL communities are always COMMON (LEVEL_1 has no department split).
  subtype          CommunitySubtype  @default(COMMON)
  /// Department name — only set when subtype = DEPARTMENT.
  department       String?
  school           String?
  woreda           String?
  zone             String?
  region           String?
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  communityMembers CommunityMember[]
  posts            CommunityPost[]
  chatRoom         ChatRoom?

  // Prevent duplicate COMMON communities for the same type+geography.
  // Prevent duplicate DEPARTMENT communities for the same type+geography+department.
  @@unique([type, subtype, school, woreda, zone, region, department], name: "unique_community_scope")
}

model CommunityMember {
  id String @id @default(cuid())

  teacherId   String
  communityId String

  status MembershipStatus @default(PENDING)

  createdAt DateTime @default(now())

  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  community Community @relation(fields: [communityId], references: [id])

  @@unique([teacherId, communityId])
}

model Category {
  id        String          @id @default(cuid())
  name      String          @unique
  createdAt DateTime        @default(now())
  posts     CommunityPost[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]
}

model CommunityPost {
  id                 String              @id @default(cuid())
  title              String
  description        String
  teacherId          String
  communityId        String
  categoryId         String
  views              Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  attachments        Attachment[]
  communityBookmarks CommunityBookmark[]
  comments           CommunityComment[]
  communityLikes     CommunityLike[]
  category           Category            @relation(fields: [categoryId], references: [id])
  community          Community           @relation(fields: [communityId], references: [id])
  teacher            Teacher             @relation(fields: [teacherId], references: [id])
  communityReports   CommunityReport[]
  tags               PostTag[]
}

model Attachment {
  id        String         @id @default(cuid())
  url       String
  fileName  String
  fileSize  Int
  type      AttachmentType
  postId    String
  createdAt DateTime       @default(now())
  post      CommunityPost  @relation(fields: [postId], references: [id])
}

model CommunityComment {
  id        String        @id @default(cuid())
  content   String
  teacherId String
  postId    String
  parentId  String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])
}

model CommunityLike {
  id        String        @id @default(cuid())
  teacherId String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
}

model CommunityBookmark {
  id        String        @id @default(cuid())
  teacherId String
  postId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id])
  teacher   Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
}

model CommunityReport {
  id          String        @id @default(cuid())
  reason      ReportReason
  description String?
  teacherId   String
  postId      String
  status      ReportStatus  @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  teacher     Teacher       @relation(fields: [teacherId], references: [id])

  @@unique([teacherId, postId])
}

model PostTag {
  postId String
  tagId  String
  post   CommunityPost @relation(fields: [postId], references: [id])
  tag    Tag           @relation(fields: [tagId], references: [id])

  @@id([postId, tagId])
}

model TeacherActivity {
  id          String               @id @default(cuid())
  teacherId   String
  teacher     Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  type        TeacherActivityType
  points      Int
  referenceId String?
  createdAt   DateTime             @default(now())

  @@index([teacherId])
  @@index([teacherId, type, createdAt])
  @@unique([teacherId, type, referenceId])
}

model TeacherVerificationDocument {
  id           String                     @id @default(cuid())
  teacherId    String
  teacher      Teacher                    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  fileName     String
  filePath     String
  fileType     VerificationDocumentType
  mimeType     String
  fileSize     Int
  uploadedAt   DateTime                   @default(now())

  @@index([teacherId])
}

enum VerificationDocumentType {
  TEACHER_ID
  EMPLOYMENT_LETTER
  TEACHING_CERTIFICATE
  OTHER
}

enum TeacherVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeacherActivityType {
  POST_CREATED
  LIKE_RECEIVED
  BOOKMARK_RECEIVED
  VIOLATION_CONFIRMED
}

enum TeacherLevelType {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
}

enum TeacherStatus {
  ACTIVE
  SUSPENDED
}

enum CommunityType {
  SCHOOL
  WOREDA
  ZONE
  REGION
  NATIONAL
}

enum CommunitySubtype {
  COMMON
  DEPARTMENT
}

enum ReportReason {
  SPAM
  ABUSE
  HARASSMENT
  MISINFORMATION
  FAKE_INFORMATION  // Deprecated: use MISINFORMATION instead
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum AttachmentType {
  IMAGE
  PDF
  DOCX
  VIDEO
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

model Notification {
  id          String           @id @default(cuid())
  receiverId  String
  receiver    Teacher          @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  senderId    String?
  senderName  String?
  title       String
  message     String
  type        NotificationType
  referenceId String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum NotificationType {
  LIKE
  COMMENT
  BOOKMARK
  COMMUNITY_JOIN
  LEVEL_UPGRADE
  REPORT
  SYSTEM
  REPLY
  CHAT_MESSAGE
}

model ChatRoom {
  id                String          @id @default(cuid())
  communityId       String          @unique
  community         Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)
  messages          ChatMessage[]
  pinnedMessages    PinnedMessage[]
  unreadCounts      ChatUnreadCount[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([communityId])
}

model ChatMessage {
  id                String              @id @default(cuid())
  chatRoomId        String
  chatRoom          ChatRoom            @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  senderId          String
  sender            Teacher             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content           String
  replyToId         String?
  replyTo           ChatMessage?        @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           ChatMessage[]       @relation("MessageReplies")
  editedAt          DateTime?
  deletedAt         DateTime?
  attachments       ChatAttachment[]
  reactions         ChatReaction[]
  readBy            ChatMessageRead[]
  pinnedMessage     PinnedMessage?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([chatRoomId])
  @@index([senderId])
  @@index([createdAt])
  @@index([deletedAt])
}

model ChatAttachment {
  id          String    @id @default(cuid())
  messageId   String
  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  url         String
  fileName    String
  fileSize    Int
  type        AttachmentType
  createdAt   DateTime  @default(now())

  @@index([messageId])
}

model ChatReaction {
  id        String    @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reaction  String    // emoji like "👍", "❤️", "😂", etc.
  createdAt DateTime  @default(now())

  @@unique([messageId, teacherId, reaction])
  @@index([messageId])
  @@index([teacherId])
}

model ChatMessageRead {
  id        String    @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  readAt    DateTime  @default(now())

  @@unique([messageId, teacherId])
  @@index([messageId])
  @@index([teacherId])
}

model PinnedMessage {
  id        String    @id @default(cuid())
  chatRoomId String
  chatRoom  ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  messageId String    @unique
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  pinnedBy  String
  pinnedByTeacher Teacher @relation(fields: [pinnedBy], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([chatRoomId])
  @@index([messageId])
}

model ChatUnreadCount {
  id        String    @id @default(cuid())
  chatRoomId String
  chatRoom  ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  count     Int       @default(0)
  updatedAt DateTime  @updatedAt

  @@unique([chatRoomId, teacherId])
  @@index([chatRoomId])
  @@index([teacherId])
}
